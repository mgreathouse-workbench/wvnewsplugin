{
  "name": "wvnews-print-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "WVNews Print \u2014 Adobe InDesign UXP panel. The plugin source needs no build step; this manifest exists for the lint gate and the packaging scripts.",
  "scripts": {
    "lint": "eslint plugin scripts tests dev --ext .js,.mjs --quiet",
    "lint:all": "eslint plugin scripts tests dev --ext .js,.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "node dev/smoke.mjs",
    "preview": "node dev/serve.mjs",
    "build": "node scripts/build-plugin-ccx.js"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "puppeteer-core": "24.42.0"
  }
}
